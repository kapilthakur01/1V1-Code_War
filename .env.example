# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/codeclash

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Judge ────────────────────────────────────────────────
JUDGE_TIMEOUT_MS=2000
JUDGE_MEMORY_MB=256
TEMP_DIR=./temp
